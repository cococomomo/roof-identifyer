# ═══ Roof Identifier / CRM — .env (Vorlage) ═══
# Kopieren:  cp .env.example .env   und Werte anpassen.
# Geheimnisse & Betriebsdaten nicht ins Repository committen.

# ── HTTP-Server (lokal: 3007; ggf. über PM2) ─────────────────
PORT=3007

# ── Betriebsdaten (optional) ─────────────────────────────────
# Lokal/Entwicklung:  Zeile ganz weglassen → alles in ./data neben dem Projekt.
# Produktion:         fester Ordner UNTERHALB /opt/…, z. B. (Deploy kann ergänzen):
#   DATA_DIR=/var/lib/roof-identifyer
# Abweichungen nur auf einem Rechner:  .env.local  anlegen (nicht in Git, nicht
# per deploy.ps1 / deploy.sh mit kopiert) — z. B. anderes DATA_DIR lokal.
# DATA_DIR=

# ── EVN WMS: Trafo-Karte (Pflicht für Scans) ────────────────
TRAFO_MAP_URL=https://…/qgis_mapserv…?MAP=…

# ── E-Mail (optional; ohne Eintrag werden keine Mails versendet) ─
MY_EMAIL=you@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=…

# ── OpenStreetMap / Overpass (optional; kommagetrennte Spiegel-URLs) ─
# OVERPASS_URL=https://overpass-api.de/api/interpreter

# ── Google: Places & Kalender-Integration (optional) ─────────
# GOOGLE_PLACES_API_KEY=
# GOOGLE_PLACES_ENABLED=false
# GOOGLE_CREDS_PATH=
# GOOGLE_TOKEN_PATH=

# ── Nominatim-User-Agent (optional) ─────────────────────────
# NOMINATIM_UA=MeineFirma/1.0 (Kontakt)
